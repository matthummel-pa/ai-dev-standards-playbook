{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git worktree:*)",
      "Bash(git push -u origin feat/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git push origin feat/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(git push origin chore/:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow run deploy.yml:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(composer install:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpcs:*)",
      "Bash(phpcs:*)",
      "Bash(python3 .github/scripts/wp-review:*)",
      "Bash(wp-review:*)",
      "Bash(wp acorn:*)",
      "Bash(rg:*)",
      "Bash(curl -sI:*)",
      "Bash(studio wp acorn:*)",
      "Bash(studio wp cache flush:*)",
      "WebFetch(domain:developer.wordpress.org)",
      "WebFetch(domain:make.wordpress.org)",
      "WebFetch(domain:roots.io)",
      "WebFetch(domain:freemius.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:wpbones.com)",
      "WebFetch(domain:www.w3.org)",
      "WebFetch(domain:ahrefs.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:html.spec.whatwg.org)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebFetch(domain:javascript.info)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:moderncss.dev)",
      "WebFetch(domain:caniuse.com)",
      "WebFetch(domain:cssdb.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:javascriptweekly.com)",
      "WebFetch(domain:cssweekly.co)"
    ],
    "ask": [
      "Bash(gh pr review:*)",
      "Bash(studio wp:*)",
      "Bash(wp:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./wp-config.php)",
      "Read(./.deploy-keys/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(studio delete:*)",
      "Bash(studio preview delete:*)",
      "Bash(wp db reset:*)",
      "Bash(wp db drop:*)",
      "Bash(studio wp db reset:*)",
      "Bash(studio wp db drop:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/phpcs-on-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
